# ============================================================
# LLM Eval & Guardrails Framework — environment template
# ============================================================
# This file (.env.local) is an EXAMPLE with placeholder values.
# It is committed on purpose so anyone can see every variable and
# where to obtain it. To run for real:
#
#     cp .env.local .env
#     # then edit .env and put your real keys there
#
# .env is git-ignored, .env.local is not. Never put real secrets
# in .env.local.
#
# IMPORTANT: the default test suite and the example scripts run
# fully OFFLINE with no keys at all (local deterministic embeddings
# + in-memory vector store + a mock LLM). You only need keys below
# when you want to evaluate against a real model.
# ============================================================


# ------------------------------------------------------------
# LLM PROVIDER
# ------------------------------------------------------------
# Which chat/completions provider to use:
#   mock      -> deterministic, no network, no key (default; used by tests)
#   openai    -> OpenAI or ANY OpenAI-compatible endpoint (Groq, DeepSeek, ...)
#   anthropic -> Anthropic Claude
LLM_PROVIDER=mock

# --- Option A: FREE / cheap OpenAI-compatible providers (recommended) --------
# Groq (free tier, very fast). Get a key at: https://console.groq.com/keys
# Then set:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_your_groq_key
#   LLM_MODEL=llama-3.3-70b-versatile
#
# DeepSeek (very cheap, has trial credit). Get a key at:
#   https://platform.deepseek.com/api_keys
# Then set:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=sk_your_deepseek_key
#   LLM_MODEL=deepseek-chat
#
# OpenAI (paid). Get a key at: https://platform.openai.com/api-keys
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-proj-...
#   LLM_MODEL=gpt-4o-mini

# Base URL for the OpenAI-compatible endpoint (leave blank for real OpenAI).
LLM_BASE_URL=https://api.groq.com/openai/v1

# API key for the chosen LLM provider (see links above for where to get it).
LLM_API_KEY=

# Model id to evaluate (must exist on the chosen provider).
LLM_MODEL=llama-3.3-70b-versatile

# --- Option B: Anthropic Claude ---------------------------------------------
# Get a key at: https://console.anthropic.com/settings/keys
# Then set LLM_PROVIDER=anthropic and fill:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Sampling temperature for the model under test (0 = most deterministic).
LLM_TEMPERATURE=0


# ------------------------------------------------------------
# EMBEDDINGS (used by semantic-similarity and RAG groundedness)
# ------------------------------------------------------------
# Which embedding backend to use:
#   local  -> deterministic hashing embeddings, no network, no key (default)
#   openai -> OpenAI-compatible embeddings endpoint
EMBEDDING_PROVIDER=local

# For EMBEDDING_PROVIDER=openai. OpenAI embeddings key/URL.
# Get a key at: https://platform.openai.com/api-keys
# (Groq/DeepSeek do not serve embeddings today, so use OpenAI or a
#  self-hosted OpenAI-compatible embedding server here.)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small


# ------------------------------------------------------------
# VECTOR STORE (for the RAG retrieval examples)
# ------------------------------------------------------------
# Which vector store to use:
#   memory  -> in-process, no dependency, no service (default; used by tests)
#   pgvector-> PostgreSQL + pgvector extension
#   qdrant  -> Qdrant vector database
VECTOR_STORE=memory

# For VECTOR_STORE=pgvector. Spin one up locally with:
#   docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg16
# Connection string for that Postgres instance:
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/postgres

# For VECTOR_STORE=qdrant. Spin one up locally with:
#   docker run -p 6333:6333 qdrant/qdrant
# Qdrant endpoint and (optional) API key from https://cloud.qdrant.io if hosted:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=


# ------------------------------------------------------------
# GUARDRAIL / QUALITY GATE THRESHOLDS
# ------------------------------------------------------------
# Minimum fraction of eval cases that must pass (0.0 - 1.0).
# The CI gate exits non-zero (blocks deploy) when the run drops below this.
GATE_MIN_PASS_RATE=0.9

# Minimum mean confidence across cases required to pass the gate (0.0 - 1.0).
GATE_MIN_CONFIDENCE=0.6

# Max allowed NEW regressions versus the saved baseline snapshot before the
# gate fails. 0 = no regression tolerated.
GATE_MAX_REGRESSIONS=0

# Where snapshots (baselines for regression detection) are stored.
SNAPSHOT_DIR=.llm-eval/snapshots
